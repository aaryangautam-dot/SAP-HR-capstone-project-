{
    "name": "hrselfservice",
    "version": "0.0.1",
    "description": "hrselfservice description",
    "keywords": [
        "ui5",
        "openui5",
        "sapui5"
    ],
    "main": "webapp/index.html",
    "dependencies": {},
    "devDependencies": {
        "@ui5/cli": "^4.0.33",
        "@sap/ux-ui5-tooling": "1",
        "@sap-ux/eslint-plugin-fiori-tools": "^10.0.0",
        "eslint": "^10",
        "@ui5/linter": "latest"
    },
    "scripts": {
        "start": "fiori run --port 8085 --open index.html",
        "build": "ui5 build --config=ui5.yaml --clean-dest --dest dist && node -e \"require('fs').cpSync('dist', '../approuter/dist/hrselfservice', {recursive:true})\" && node ../scripts/create-zip.js dist dist/hrselfservice.zip",
        "build:dist": "ui5 build --config=ui5.yaml --clean-dest --dest dist",
        "lint": "eslint ./",
        "start-variants-management": "fiori run --open \"/preview.html?sap-ui-xx-viewCache=false&fiori-tools-rta-mode=true&sap-ui-rta-skip-flex-validation=true#hrselfservice-display\"",
        "ui5lint": "ui5lint"
    }
}