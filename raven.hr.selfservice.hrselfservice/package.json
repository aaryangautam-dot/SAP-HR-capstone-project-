{
    "name": "raven.hr.selfservice.hrselfservice",
    "scripts": {
        "build": "mbt build --mtar raven.hr.selfservice.hrselfservice.mtar",
        "build:workspaces": "npm run build --workspaces --if-present",
        "deploy": "cf deploy mta_archives/raven.hr.selfservice.hrselfservice.mtar --retries 0",
        "lint": "npm run lint --workspaces --if-present",
        "ui5lint": "npm run ui5lint --workspaces --if-present",
        "start:hrselfservice": "npm start --workspace hrselfservice",
        "start:hradmin": "npm start --workspace hradmin",
        "qunit": "fiori run --open test/unitTests.qunit.html"
    },
    "dependencies": {
        "mbt": "^1"
    },
    "workspaces": [
        "hrselfservice",
        "hradmin"
    ],
    "devDependencies": {
        "archiver": "^8.0.0"
    }
}
