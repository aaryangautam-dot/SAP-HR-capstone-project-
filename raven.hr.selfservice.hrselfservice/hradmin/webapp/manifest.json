{
    "_version": "1.86.0",

    "sap.cloud": {
        "public": true,
        "service": "raven.hr"
    },

    "sap.app": {
        "id": "hradmin",
        "type": "application",
        "i18n": {
            "bundleUrl": "i18n/i18n.properties",
            "supportedLocales": [
                ""
            ],
            "fallbackLocale": ""
        },
        "applicationVersion": {
            "version": "0.0.1"
        },
        "title": "HR Admin & Manager Workspace",
        "description": "HR Admin and Manager Workspace Application",
        "resources": "resources.json",

        "dataSources": {
            "mainService": {
                "uri": "odata/v4/hr/",
                "type": "OData",
                "settings": {
                    "odataVersion": "4.0"
                }
            }
        },

        "crossNavigation": {
            "inbounds": {
                "HRAdmin-manage": {
                    "semanticObject": "HRAdmin",
                    "action": "manage",
                    "title": "Employee Master",
                    "subTitle": "Employee Master & Directory",
                    "icon": "sap-icon://manager-insight",
                    "signature": {
                        "parameters": {
                            "route": {
                                "defaultValue": {
                                    "value": "employeeDirectory"
                                }
                            },
                            "tab": {
                                "defaultValue": {
                                    "value": "employees"
                                }
                            }
                        },
                        "additionalParameters": "allowed"
                    }
                },
                "HRAdmin-overview": {
                    "semanticObject": "HRAdmin",
                    "action": "overview",
                    "title": "Leave Requests Overview",
                    "subTitle": "Department Leave Overview",
                    "icon": "sap-icon://general-leave-request",
                    "signature": {
                        "parameters": {
                            "route": {
                                "defaultValue": {
                                    "value": "leaveRequests"
                                }
                            },
                            "tab": {
                                "defaultValue": {
                                    "value": "overview"
                                }
                            }
                        },
                        "additionalParameters": "allowed"
                    }
                },
                "HRAdmin-approvals": {
                    "semanticObject": "HRAdmin",
                    "action": "approvals",
                    "title": "Pending Approvals",
                    "subTitle": "Manager Action Queue",
                    "icon": "sap-icon://approvals",
                    "signature": {
                        "parameters": {
                            "route": {
                                "defaultValue": {
                                    "value": "pendingApprovals"
                                }
                            },
                            "tab": {
                                "defaultValue": {
                                    "value": "approvals"
                                }
                            }
                        },
                        "additionalParameters": "allowed"
                    }
                }
            }
        }
    },

    "sap.ui": {
        "technology": "UI5",
        "deviceTypes": {
            "desktop": true,
            "tablet": true,
            "phone": true
        }
    },

    "sap.ui5": {
        "flexEnabled": true,

        "dependencies": {
            "minUI5Version": "1.148.3",
            "libs": {
                "sap.m": {},
                "sap.ui.core": {},
                "sap.f": {},
                "sap.ui.layout": {}
            }
        },

        "contentDensities": {
            "compact": true,
            "cozy": true
        },

        "models": {
            "i18n": {
                "type": "sap.ui.model.resource.ResourceModel",
                "settings": {
                    "bundleName": "hradmin.i18n.i18n",
                    "supportedLocales": [
                        ""
                    ],
                    "fallbackLocale": ""
                }
            },

            "": {
                "type": "sap.ui.model.odata.v4.ODataModel",
                "dataSource": "mainService",
                "preload": true,
                "settings": {
                    "operationMode": "Server",
                    "autoExpandSelect": true,
                    "earlyRequests": true
                }
            }
        },

        "routing": {
            "config": {
                "routerClass": "sap.m.routing.Router",
                "controlAggregation": "pages",
                "controlId": "app",
                "transition": "slide",
                "type": "View",
                "viewType": "XML",
                "viewPath": "hradmin.view",
                "async": true
            },

            "routes": [
                {
                    "name": "main",
                    "pattern": "",
                    "target": "main"
                },
                {
                    "name": "employeeDirectory",
                    "pattern": "employee-directory",
                    "target": "main"
                },
                {
                    "name": "employees",
                    "pattern": "employees",
                    "target": "main"
                },
                {
                    "name": "leaveRequests",
                    "pattern": "leave-requests",
                    "target": "main"
                },
                {
                    "name": "pendingApprovals",
                    "pattern": "pending-approvals",
                    "target": "main"
                }
            ],

            "targets": {
                "main": {
                    "viewName": "Main",
                    "viewId": "Main"
                }
            }
        },

        "rootView": {
            "viewName": "hradmin.view.App",
            "type": "XML",
            "id": "App"
        }
    }
}
