{
    "welcomeFile": "/index.html",

    "authenticationMethod": "route",

    "routes": [
        {
            "source": "^/odata/v4/hr/(.*)$",
            "target": "/odata/v4/hr/$1",
            "destination": "capm-service",
            "authenticationType": "xsuaa",
            "csrfProtection": false
        },
        {
            "source": "/user-api/currentUser$",
            "target": "/currentUser",
            "service": "sap-approuter-userapi",
            "authenticationType": "xsuaa"
        },
        {
            "source": "^/admin/(.*)$",
            "target": "$1",
            "localDir": "dist/hradmin",
            "authenticationType": "xsuaa"
        },
        {
            "source": "^(.*)$",
            "target": "$1",
            "localDir": "dist/hrselfservice",
            "authenticationType": "xsuaa"
        }
    ]
}